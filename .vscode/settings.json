// This file is generated with
// https://github.com/Cherepanov-Pavel/shareable-config
// Version: 1.0.3
// File may contain override sections, see project README for more details
{
	"editor.linkedEditing": true,
  "editor.suggestSelection": "recentlyUsed",
	"git.blame.editorDecoration.enabled": true,

	"explorer.fileNesting.enabled": true,
	"explorer.fileNesting.patterns": {
		"frontend-configs.env.json5": "eslint.config.*s, stylelint.config.*s, .editorconfig",
    ".env.*.local": ".env.*",
    ".gitignore": ".gitattributes, lefthook.yml",
    // ".gitlab-ci.yml": "Dockerfile, .releaserc.template.yaml",
    "package.json": ".npmrc, package-lock.json",
    "README.md": "*.md",
    "tsconfig.json": "tsconfig.*.json, *.d.ts"
	},

	"javascript.preferences.importModuleSpecifier": "non-relative",
  "typescript.preferences.importModuleSpecifier": "non-relative",
  "typescript.tsdk": "./node_modules/typescript/lib",
  "typescript.enablePromptUseWorkspaceTsdk": true,

	"json.validate.enable": false,
  "editor.formatOnSave": false,
  "editor.codeActionsOnSave": {
    "source.fixAll.eslint": "explicit",
    "source.fixAll.stylelint": "explicit",
  },
	// "stylelint.validate": [
  //   "css",
  //   "scss",
  //   "vue"
  // ],

	"cSpell.words": [
		"Cherepanov",
		"Customizer",
		"Nuxt",
		"Pavel",
		"vuejs"
	],

	// override
	"editor.renderWhitespace": "selection",
	"cSpell.language": "en,ru"
}
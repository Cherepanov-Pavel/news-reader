{
	"name": "news-reader",
	"type": "module",
	"devEngines": {
		"packageManager": {
			"name": "npm",
			"version": "11.19.0"
		},
		"runtime": {
			"name": "node",
			"version": "26.7.0"
		}
	},
	"scripts": {
		"postinstall": "nuxt prepare",
		"dev": "nuxt dev --dotenv .env.development",
		"build": "nuxt build",
		"lint": "run-p -lc lint:js lint:css lint:types",
		"lint:fix": "run-p -lc lint:js:fix lint:css:fix lint:types",
		"lint:js": "eslint",
		"lint:js:fix": "npm run lint:js -- --fix",
		"lint:css": "stylelint \"./**/*.{css,vue}\" --ignore-path .gitignore --formatter verbose",
		"lint:css:fix": "npm run lint:css -- --fix",
		"lint:types": "nuxt typecheck --dotenv .env.development"
	},
	"allowScripts": {
		"esbuild": true,
		"lefthook": true
	},
	"dependencies": {
		"@pinia/nuxt": "^1.0.1",
		"@tailwindcss/vite": "^4.3.3",
		"@vueuse/nuxt": "^14.4.0",
		"fast-xml-parser": "^5.10.1",
		"nuxt": "^4.5.2",
		"pinia": "^4.0.2",
		"tailwindcss": "^4.3.3",
		"vue": "^3.5.40",
		"vue-router": "^5.2.0",
		"zod": "^4.4.3"
	},
	"devDependencies": {
		"@cherepanov.pavel/shareable-config": "^1.0.19",
		"@types/node": "^26.2.0",
		"eslint-plugin-tailwindcss": "^4.3.0",
		"eslint-plugin-vuejs-accessibility": "^2.6.0",
		"lefthook": "^2.1.10",
		"unplugin-icons": "^23.0.1",
		"vue-tsc": "^3.3.10"
	}
}

# this env file contains json objects, editing values in which can be a difficult task. To make it easier:
# 1. open the developer console in your browser
# 2. copy and paste the json variable you are interested in there
# 3. If everything is done correctly, you will see the object in its normal view in the console output, edit its properties as needed
# 4. Right-click on the object you edited, select "copy object"
# 5. Enter JSON.stringify() in the console, paste the contents of the clipboard between the brackets
# 6. Right-click on the resulting output, select "copy string as javascript literal" and change the variable here

NUXT_PUBLIC_RSS_SOURCE_LIST='[{ "href": "https://lenta.ru/rss/news" }, { "href": "https://mos.ru/rss" }]'

NUXT_PAGE_SIZE=6
